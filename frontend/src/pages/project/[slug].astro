---
export const prerender = true;
import { ClientRouter } from "astro:transitions";
import "../../styles/global.css";
import { client, urlFor } from "../../utils/sanity.js";
import SiteNav from "../../components/SiteNav.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
    // We fetch ALL projects ordered by publishDate desc first so we can calculate Next/Prev
    const projects =
        await client.fetch(`*[_type == "project" && defined(slug.current)] | order(coalesce(publishDate, _createdAt) desc) {
        ...,
        "shortVideoUrl": shortVideo.asset->url
    }`);

    return projects.map((project: any, index: number) => {
        // Calculate the previous and next projects in the array
        const prevProject = index > 0 ? projects[index - 1] : null;
        const nextProject =
            index < projects.length - 1 ? projects[index + 1] : null;

        return {
            params: { slug: project.slug.current },
            props: { project, prevProject, nextProject },
        };
    });
}

interface ProjectProps {
    title?: string;
    tag?: string;
    subtitle?: string;
    description?: string;
    shortVideoUrl?: string;
    videoUrl?: string;
    mainImage?: any;
    gallery?: any[];
    wipImages?: any[];
    finalImages?: any[];
    socialLinks?: Array<{ platform: string; url: string }>;
    slug: { current: string };
}

const { project, prevProject, nextProject } = Astro.props as {
    project: ProjectProps;
    prevProject: any;
    nextProject: any;
};

function getYouTubeId(url: string | undefined) {
    if (!url) return null;
    const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|shorts\/))([\w-]{11})/);
    return match ? match[1] : null;
}
const ytId = getYouTubeId(project.videoUrl);
const isShortVideo = Boolean(project.videoUrl && (project.videoUrl.includes("/shorts/") || project.videoUrl.includes("shorts")));

/* SAFETY FIX 1: Check if mainImage.asset actually exists before making URL, format to WebP */
const posterUrl =
    project.mainImage && project.mainImage.asset
        ? urlFor(project.mainImage).width(1920).auto("format").url()
        : "";

/* Open Graph specific image URL (smaller for social sharing), format to WebP */
const ogImageUrl =
    project.mainImage && project.mainImage.asset
        ? urlFor(project.mainImage).width(1200).height(630).auto("format").url()
        : "";

/* SAFETY FIX 2: Pre-filter the arrays so ghost headers don't render */
const validFinalImages =
    project.finalImages?.filter(
        (img: any) => img && img.asset && img.asset._ref,
    ) || [];
const validWipImages =
    project.wipImages?.filter(
        (img: any) => img && img.asset && img.asset._ref,
    ) || [];

/* Build JSON-LD Structured Data Schema */
// Build multi-image array: mainImage + all valid final images
const schemaImages = [
    ...(ogImageUrl ? [ogImageUrl] : []),
    ...validFinalImages.map((img: any) => {
        try { return urlFor(img).width(1200).auto("format").url(); } catch { return null; }
    }).filter(Boolean),
];

const visualArtworkNode: any = {
    "@type": "VisualArtwork",
    "@id": `https://xyroart.pages.dev/project/${project.slug.current}/#artwork`,
    name: project.title,
    headline: project.title,
    description: project.description
        ? project.description.substring(0, 200)
        : "A creative project by Xyro.",
    image: schemaImages.length > 1 ? schemaImages : (schemaImages[0] || "https://xyroart.pages.dev/assets/about-pic.jpg"),
    thumbnailUrl: ogImageUrl || "https://xyroart.pages.dev/assets/about-pic.jpg",
    creator: {
        "@type": "Person",
        "@id": "https://xyroart.pages.dev/#person",
        name: "Xyro",
        url: "https://xyroart.pages.dev/",
    },
    publisher: {
        "@type": "Person",
        "@id": "https://xyroart.pages.dev/#person",
    },
    artMedium: "Digital",
    artForm: project.tag || "Digital Art",
    genre: project.tag || "3D & 2D Art",
    dateCreated: (project as any).publishDate || null,
    url: `https://xyroart.pages.dev/project/${project.slug.current}/`,
};
// Only add keywords if they exist
const projectKeywords = (project as any).keywords;
if (Array.isArray(projectKeywords) && projectKeywords.length > 0) {
    visualArtworkNode.keywords = projectKeywords.join(", ");
}

const schemaGraphNodes: any[] = [
    visualArtworkNode,
    {
        "@type": "BreadcrumbList",
        "@id": `https://xyroart.pages.dev/project/${project.slug.current}/#breadcrumb`,
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: "Home",
                item: "https://xyroart.pages.dev/",
            },
            {
                "@type": "ListItem",
                position: 2,
                name: "Projects",
                item: "https://xyroart.pages.dev/#work",
            },
            {
                "@type": "ListItem",
                position: 3,
                name: project.title,
                item: `https://xyroart.pages.dev/project/${project.slug.current}/`,
            },
        ],
    },
];

// Add VideoObject node if this project has a YouTube video
if (ytId) {
    schemaGraphNodes.push({
        "@type": "VideoObject",
        "@id": `https://xyroart.pages.dev/project/${project.slug.current}/#video`,
        name: `${project.title} — by Xyro`,
        description: project.description
            ? project.description.substring(0, 200)
            : `Video for ${project.title} by Xyro.`,
        thumbnailUrl: ogImageUrl || `https://i.ytimg.com/vi/${ytId}/maxresdefault.jpg`,
        uploadDate: (project as any).publishDate || "2026-01-01",
        embedUrl: `https://www.youtube.com/embed/${ytId}`,
        url: (project as any).videoUrl,
        publisher: { "@id": "https://xyroart.pages.dev/#person" },
    });
}

const schemaData = {
    "@context": "https://schema.org",
    "@graph": schemaGraphNodes,
};

const wordCount = project.title ? project.title.split(/\s+/).filter(Boolean).length : 0;
const titleFontSize = wordCount >= 6 ? "clamp(2rem, 4.5vw, 3.8rem)" : "clamp(2.8rem, 5.5vw, 5.5rem)";
---

<!doctype html>
<html lang="en">
    <head>
        <script is:inline>
            (function(){try{var s=localStorage.getItem("xt2")||localStorage.getItem("xyro_theme");if(s==="dark"||s==="light"){document.documentElement.setAttribute("data-theme",s);}}catch(e){}})();
        </script>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{project.title} — Xyro</title>
        <link
            rel="canonical"
            href={`https://xyroart.pages.dev/project/${project.slug.current}/`}
        />

        {/* --- BRANDING METADATA --- */}
        <meta name="theme-color" content="#0d0d0d" />
        <meta name="apple-mobile-web-app-title" content="Xyro" />
        <meta name="application-name" content="Xyro" />

        <ClientRouter />

        {/* --- SEO & OPEN GRAPH METADATA --- */}
        <meta
            name="description"
            content={project.description
                ? project.description.substring(0, 150) + "..."
                : "A creative project by Xyro."}
        />
        <meta property="og:title" content={`${project.title} — Xyro`} />
        <meta
            property="og:description"
            content={project.description
                ? project.description.substring(0, 150) + "..."
                : "A creative project by Xyro."}
        />
        <meta property="og:type" content="article" />
        <meta
            property="og:url"
            content={`https://xyroart.pages.dev/project/${project.slug.current}/`}
        />
        <meta property="og:site_name" content="Xyro" />
        {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

        {/* --- TWITTER CARDS --- */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={`${project.title} — Xyro`} />
        <meta
            name="twitter:description"
            content={project.description
                ? project.description.substring(0, 150) + "..."
                : "A creative project by Xyro."}
        />
        {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

        {/* --- FAVICONS & MANIFEST (Google Guideline Stable URLs) --- */}
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png?v=4"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="48x48"
            href="/favicon-48x48.png?v=4"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png?v=4"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png?v=4"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
        <link rel="icon" href="/favicon.ico?v=4" />
        <link rel="manifest" href="/site.webmanifest?v=4" />

        {/* --- STRUCTURED DATA (JSON-LD) --- */}
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(schemaData)}
        />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Space+Grotesk:wght@500;700&display=swap"
            rel="stylesheet"
        />

        <style>
            .project-hero {
                position: relative;
                width: 100%;
                height: 70vh;
                min-height: 520px;
                overflow: hidden;
                display: flex;
                align-items: flex-end;
                padding: 60px 40px;
                background: #000;
            }
            .project-hero-bg-blur {
                position: absolute;
                inset: -20px;
                background-size: cover;
                background-position: center;
                filter: blur(24px) brightness(0.22);
                z-index: 0;
                pointer-events: none;
            }
            .project-hero-media {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: contain;
                z-index: 1;
            }
            .project-hero::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(
                    to bottom,
                    rgba(0, 0, 0, 0.3) 0%,
                    rgba(0, 0, 0, 0.1) 30%,
                    rgba(0, 0, 0, 0.4) 65%,
                    #000 100%
                );
                z-index: 2;
                pointer-events: none;
            }
            .project-hero-content {
                position: relative;
                z-index: 3;
                max-width: 1000px;
                width: 100%;
            }

            .back-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: var(--bg);
                color: var(--ink);
                border: 3px solid var(--ink);
                box-shadow: 4px 4px 0 var(--ink);
                border-radius: 99px;
                padding: 8px 22px;
                font: 700 14px 'Space Grotesk', sans-serif;
                text-decoration: none;
                margin-bottom: 24px;
                transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
            }
            .back-btn:hover {
                transform: translateY(-2px);
                box-shadow: 6px 6px 0 var(--ink);
                background: var(--yl);
                color: var(--ink);
            }

            .project-hero-title {
                font-family: 'Dela Gothic One', cursive, sans-serif;
                line-height: 1.1;
                letter-spacing: -0.02em;
                color: #fff;
                text-shadow: 3px 3px 0 #000;
                margin: 0;
            }

            .project-details {
                padding: 70px 40px;
                max-width: 1280px;
                margin: 0 auto;
                display: grid;
                grid-template-columns: 320px 1fr;
                gap: 50px;
            }
            .project-meta-card {
                background: var(--bg);
                border: 4px solid var(--ink);
                box-shadow: 6px 6px 0 var(--ink);
                border-radius: 4px;
                padding: 24px;
                height: fit-content;
            }
            .project-meta-card h3 {
                font: 400 13px 'Dela Gothic One', sans-serif;
                color: var(--rd);
                text-transform: uppercase;
                letter-spacing: 0.05em;
                margin: 0 0 6px;
            }
            .project-meta-card p {
                font: 700 18px 'Space Grotesk', sans-serif;
                color: var(--ink);
                margin: 0 0 24px;
            }
            .project-meta-card p:last-child {
                margin-bottom: 0;
            }

            .project-description {
                font: 500 18px/1.8 'Space Grotesk', sans-serif;
                color: var(--ink);
                white-space: pre-wrap;
                margin-bottom: 30px;
            }

            .social-links {
                display: flex;
                gap: 12px;
                flex-wrap: wrap;
                margin-top: 20px;
            }
            .social-btn {
                background: var(--bg);
                color: var(--ink);
                border: 3px solid var(--ink);
                box-shadow: 4px 4px 0 var(--ink);
                border-radius: 99px;
                padding: 8px 20px;
                font: 700 14px 'Space Grotesk', sans-serif;
                text-decoration: none;
                transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
            }
            .social-btn:hover {
                background: var(--pk);
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 6px 6px 0 var(--ink);
            }

            .cinematic-embed-wrapper {
                margin-top: 40px;
                width: 100%;
                max-width: 860px;
                aspect-ratio: 16 / 9;
                border-radius: 4px;
                overflow: hidden;
                background: #000;
                border: 4px solid var(--ink);
                box-shadow: 6px 6px 0 var(--ink);
            }
            .cinematic-embed-wrapper.cinematic-short {
                max-width: 380px;
                aspect-ratio: 9 / 16;
                margin-left: 0;
                margin-right: auto;
            }
            .cinematic-embed-wrapper iframe,
            .cinematic-embed-wrapper .yt-facade {
                width: 100%;
                height: 100%;
                border: 0;
                display: block;
            }
            .yt-facade {
                position: relative;
                cursor: pointer;
                background: #000;
                width: 100%;
                height: 100%;
                outline: none;
            }
            .yt-thumbnail {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                transition: filter 0.2s ease;
            }
            .yt-facade:hover .yt-thumbnail,
            .yt-facade:focus .yt-thumbnail {
                filter: brightness(0.8);
            }
            .yt-play-btn {
                position: absolute;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                pointer-events: none;
            }
            .yt-play-btn svg {
                filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.6));
                transition: transform 0.15s ease;
            }
            .yt-facade:hover .yt-play-btn svg,
            .yt-facade:focus .yt-play-btn svg {
                transform: scale(1.15);
            }

            .short-video-wrap {
                margin-top: 36px;
                width: 100%;
                max-width: 860px;
                border-radius: 4px;
                overflow: hidden;
                background: #000;
                border: 4px solid var(--ink);
                box-shadow: 6px 6px 0 var(--ink);
            }
            .short-video {
                display: block;
                width: 100%;
                height: auto;
            }

            .gallery-container {
                padding: 0 40px 80px;
                max-width: 1300px;
                margin: 0 auto;
            }
            .gallery-heading {
                font: 400 clamp(24px, 4vw, 36px) 'Dela Gothic One', sans-serif;
                color: var(--ink);
                letter-spacing: -0.02em;
                margin-bottom: 28px;
            }
            .final-grid {
                display: flex;
                flex-direction: column;
                gap: 36px;
            }
            .gallery-img-large {
                width: 100%;
                border-radius: 4px;
                display: block;
                border: 4px solid var(--ink);
                box-shadow: 8px 8px 0 var(--ink);
                background: var(--bg);
                transition: transform 0.2s, box-shadow 0.2s;
            }
            .gallery-img-large:hover {
                transform: translateY(-2px);
                box-shadow: 10px 10px 0 var(--rd);
            }
            .wip-masonry {
                column-count: 2;
                column-gap: 28px;
            }
            .gallery-img-half {
                width: 100%;
                margin-bottom: 28px;
                border-radius: 4px;
                display: block;
                break-inside: avoid;
                border: 4px solid var(--ink);
                box-shadow: 6px 6px 0 var(--ink);
                background: var(--bg);
                transition: transform 0.2s, box-shadow 0.2s;
            }
            .gallery-img-half:hover {
                transform: translateY(-2px);
                box-shadow: 8px 8px 0 var(--rd);
            }

            .project-navigation {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 24px;
                max-width: 1300px;
                margin: 0 auto;
                padding: 0 40px 50px;
            }
            .nav-card {
                background: var(--bg);
                border: 4px solid var(--ink);
                box-shadow: 6px 6px 0 var(--ink);
                border-radius: 4px;
                padding: 22px 26px;
                text-decoration: none;
                color: var(--ink);
                transition: transform 0.15s, box-shadow 0.15s;
                display: flex;
                flex-direction: column;
            }
            .nav-card:hover {
                transform: translateY(-3px);
                box-shadow: 8px 8px 0 var(--rd);
            }
            .nav-card.prev {
                text-align: left;
            }
            .nav-card.next {
                text-align: right;
            }
            .nav-label {
                font: 700 12px 'Space Grotesk', sans-serif;
                color: var(--rd);
                text-transform: uppercase;
                letter-spacing: 0.08em;
                margin-bottom: 8px;
            }
            .nav-title {
                font: 400 18px 'Dela Gothic One', sans-serif;
                color: var(--ink);
                margin: 0;
                line-height: 1.3;
            }
            .nav-title span {
                color: var(--rd);
                display: inline-block;
                transition: transform 0.15s ease;
            }
            .nav-card.prev:hover .nav-title span {
                transform: translateX(-4px);
            }
            .nav-card.next:hover .nav-title span {
                transform: translateX(4px);
            }

            .project-cta-section {
                text-align: center;
                padding: 50px 20px 60px;
                max-width: 800px;
                margin: 0 auto;
            }
            .project-cta-section h2 {
                font: 400 clamp(32px, 5vw, 54px) 'Dela Gothic One', sans-serif;
                letter-spacing: -0.02em;
                color: var(--ink);
                margin: 0 0 16px;
            }
            .project-cta-section h2 em {
                font-style: normal;
                background: var(--pk);
                color: #fff;
                padding: 0 .15em;
                display: inline-block;
                transform: rotate(-2deg);
            }
            .project-cta-section p {
                font: 700 18px 'Space Grotesk', sans-serif;
                color: var(--ink);
                opacity: 0.85;
                margin: 0 auto 28px;
            }
            .project-cta-btn {
                font-size: 18px;
                padding: 14px 36px;
                background: var(--rd);
                color: #fff;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 10px;
                box-shadow: 6px 6px 0 var(--ink);
                transition: transform 0.15s, box-shadow 0.15s;
            }
            .project-cta-btn:hover {
                transform: translateY(-2px);
                box-shadow: 8px 8px 0 var(--ink);
                color: #fff;
            }

            @media (max-width: 768px) {
                .project-hero {
                    padding: 30px 20px;
                    height: 50vh;
                    min-height: 400px;
                }
                .project-details {
                    grid-template-columns: 1fr;
                    padding: 40px 20px;
                    gap: 30px;
                }
                .gallery-container {
                    padding: 0 20px 60px;
                }
                .wip-masonry {
                    column-count: 1;
                }
                .project-navigation {
                    grid-template-columns: 1fr;
                    gap: 18px;
                    padding: 0 20px 40px;
                }
                .nav-card.next {
                    text-align: left;
                }
            }
        </style>
    </head>
    <body>
        <SiteNav isHomepage={false} hideLogoOnTop={false} />

        <header class="project-hero">
            <div class="project-hero-bg-blur" style={`background-image: url(${posterUrl});`} />
            {
                project.shortVideoUrl ? (
                    <video
                        src={project.shortVideoUrl}
                        poster={posterUrl}
                        class="project-hero-media"
                        autoplay
                        muted
                        loop
                        playsinline
                    />
                ) : project.mainImage && project.mainImage.asset ? (
                    <img
                        src={posterUrl}
                        alt={project.mainImage.alt || project.title}
                        class="project-hero-media"
                    />
                ) : null
            }

            <div class="project-hero-content">
                <a href="/vault" class="back-btn">← Back to Vault</a>
                <h1 class="project-hero-title" style={`font-size: ${titleFontSize};`}>
                    {project.title}
                </h1>
            </div>
        </header>

        <section class="project-details">
            <div class="project-meta-card">
                <h3>Role / Service</h3>
                <p>{project.tag || "N/A"}</p>

                <h3>Category</h3>
                <p>{project.subtitle || "N/A"}</p>
            </div>
            <div class="project-info">
                <div class="project-description">
                    {project.description || "In-depth case study coming soon."}
                </div>

                {
                    project.socialLinks && project.socialLinks.length > 0 && (
                        <div class="social-links">
                            {project.socialLinks.map((link) => (
                                <a
                                    href={link.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="social-btn"
                                >
                                    View on {link.platform} ↗
                                </a>
                            ))}
                        </div>
                    )
                }

                {/* SHORT VIDEO — Sanity-hosted mp4/webm loop (turntables, process clips) */}
                {
                    project.shortVideoUrl && (
                        <div class="short-video-wrap">
                            <video
                                src={project.shortVideoUrl}
                                autoplay
                                loop
                                muted
                                playsinline
                                class="short-video"
                                aria-label={`${project.title} — process preview`}
                            />
                        </div>
                    )
                }

                {/* YOUTUBE VIDEO — lazy facade: shows thumbnail, loads iframe on click */}
                {
                    ytId && (
                        <div class={`cinematic-embed-wrapper ${isShortVideo ? "cinematic-short" : ""}`}>
                            <div
                                class="yt-facade"
                                data-ytid={ytId}
                                role="button"
                                tabindex="0"
                                aria-label={`Play ${project.title} on YouTube`}
                            >
                                <img
                                    src={`https://i.ytimg.com/vi/${ytId}/maxresdefault.jpg`}
                                    alt={`${project.title} — video thumbnail`}
                                    loading="lazy"
                                    class="yt-thumbnail"
                                    onerror="this.src='https://i.ytimg.com/vi/' + this.dataset.ytid + '/hqdefault.jpg'"
                                />
                                <span class="yt-play-btn" aria-hidden="true">
                                    <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C56.1 0 34 0 34 0S11.9 0 7.5 1.7a8.5 8.5 0 0 0-6 6C0 12.1 0 24 0 24s0 11.9 1.5 16.3a8.5 8.5 0 0 0 6 6C11.9 48 34 48 34 48s22.1 0 26.5-1.7a8.5 8.5 0 0 0 6-6C68 35.9 68 24 68 24s0-11.9-1.5-16.3z" fill="#ff0000"/><path d="M27 34l18-10-18-10v20z" fill="#fff"/></svg>
                                </span>
                            </div>
                        </div>
                    )
                }
            </div>
        </section>

        {/* FINAL ARTWORK SECTION (Auto-format WebP + Dynamic Alt) */}
        {
            validFinalImages.length > 0 && (
                <section class="gallery-container">
                    <h2 class="gallery-heading">Final Artwork</h2>
                    <div class="final-grid">
                        {validFinalImages.map((image: any, index: number) => (
                            <img
                                src={urlFor(image)
                                    .width(1920)
                                    .auto("format")
                                    .url()}
                                alt={
                                    image.alt ||
                                    `Final Artwork ${index + 1} - ${project.title}`
                                }
                                class="gallery-img-large"
                                loading="lazy"
                            />
                        ))}
                    </div>
                </section>
            )
        }

        {/* WIP SECTION (Auto-format WebP + Dynamic Alt) */}
        {
            validWipImages.length > 0 && (
                <section class="gallery-container">
                    <h2 class="gallery-heading">Work in Progress</h2>
                    <div class="wip-masonry">
                        {validWipImages.map((image: any, index: number) => (
                            <img
                                src={urlFor(image)
                                    .width(800)
                                    .auto("format")
                                    .url()}
                                alt={
                                    image.alt ||
                                    `Work in Progress ${index + 1} - ${project.title}`
                                }
                                class="gallery-img-half"
                                loading="lazy"
                            />
                        ))}
                    </div>
                </section>
            )
        }

        {/* PROJECT NAVIGATION */}
        <div class="project-navigation">
            {
                prevProject ? (
                    <a
                        href={`/project/${prevProject.slug.current}`}
                        class="nav-card prev"
                    >
                        <span class="nav-label">Previous Project</span>
                        <h4 class="nav-title">
                            <span>&larr;</span> {prevProject.title}
                        </h4>
                    </a>
                ) : (
                    <div class="nav-card prev" style="visibility: hidden;" />
                )
            }

            {
                nextProject ? (
                    <a
                        href={`/project/${nextProject.slug.current}`}
                        class="nav-card next"
                    >
                        <span class="nav-label">Next Project</span>
                        <h4 class="nav-title">
                            {nextProject.title} <span>&rarr;</span>
                        </h4>
                    </a>
                ) : (
                    <div class="nav-card next" style="visibility: hidden;" />
                )
            }
        </div>

        <section class="project-cta-section">
            <h2>Ready to start your <em>project?</em></h2>
            <p>Commission manga pages, character designs, 3D scenes & illustrations.</p>
            <a href="/#contact" class="pill big project-cta-btn">Book a Slot →</a>
        </section>

        <Footer isHomepage={false} />

        <script>
            document.addEventListener("astro:after-swap", () => {
                try {
                    const s = localStorage.getItem("xt2") || localStorage.getItem("xyro_theme");
                    if (s) document.documentElement.setAttribute("data-theme", s);
                } catch (e) {}
            });

            document.addEventListener("astro:page-load", () => {
                // YOUTUBE LAZY FACADE — swap thumbnail for real iframe on click / keypress
                document.querySelectorAll(".yt-facade").forEach((facade) => {
                    const loadYT = () => {
                        const ytId = facade.getAttribute("data-ytid");
                        if (!ytId) return;
                        const iframe = document.createElement("iframe");
                        iframe.src = `https://www.youtube.com/embed/${ytId}?autoplay=1&rel=0&modestbranding=1`;
                        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
                        iframe.allowFullscreen = true;
                        iframe.style.cssText = "width:100%;height:100%;border:0;display:block;";
                        facade.replaceWith(iframe);
                    };
                    facade.addEventListener("click", loadYT);
                    facade.addEventListener("keydown", (e: any) => {
                        if (e.key === "Enter" || e.key === " ") {
                            e.preventDefault();
                            loadYT();
                        }
                    });
                });
            });
        </script>
    </body>
</html>
