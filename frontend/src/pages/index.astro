          ? new IntersectionObserver(
              function (es) {
                es.forEach(function (e) {
                  e.target.classList.toggle("on", e.intersectionRatio > 0.6);
                });
              },
              { threshold: [0, 0.6] },
            )
          : null;

      function vd() {
        var g = $("vg");
        if (!g) return;
        vs = D.slice(0, 4);

        var btns = g.querySelectorAll(".vi");
        if (btns.length === vs.length && vs.length > 0) {
          btns.forEach(function (b, n) {
            b.onclick = function () {
              sh(n);
              var lb = $("lb");
              if (lb && typeof lb.showModal === "function") lb.showModal();
            };
            if (io) io.observe(b);
          });
          return;
        }

        g.innerHTML = "";
        vs.forEach(function (d, n) {
          var b = document.createElement("button");
          b.className = "vi";
          b.type = "button";
          b.innerHTML =
            '<div class="vc"><span class="vy">' +
            d.y +
            "</span>" +
            tl(d) +
            '<div class="vm">' +
            d.g.join(" · ") +
            "</div></div>";
          b.onclick = function () {
            sh(n);
            var lb = $("lb");
            if (lb && typeof lb.showModal === "function") lb.showModal();
          };
          g.appendChild(b);
          if (io) io.observe(b);
        });
      }

      function sh(n) {
        var d = vs[n];
        if (!d) return;
        var lt = $("lt");
        if (lt)
          lt.outerHTML = tl(d).replace('class="vt"', 'class="vt lbt" id="lt"');
      }

      if ($("cl"))
        $("cl").onclick = function () {
          var lb = $("lb");
          if (lb) lb.close();
        };

      var lbEl = $("lb");
      if (lbEl) {
        lbEl.addEventListener("click", function (e) {
          if (e.target == lbEl) lbEl.close();
        });
      }

      /* client reviews direct image preview */
      document.querySelectorAll(".rev-thumb-btn, .rev-work-title-btn").forEach(function (btn) {
        btn.onclick = function () {
          var fullImg = btn.getAttribute("data-fullimg");
          var title = btn.getAttribute("data-title") || "Artwork preview";
          if (!fullImg) return;
          var lt = $("lt");
          if (lt) {
            lt.outerHTML = '<div class="vt lbt" id="lt"><img src="' + fullImg + '" alt="' + title + '" loading="lazy"></div>';
          }
          var lb = $("lb");
          if (lb && typeof lb.showModal === "function") lb.showModal();
        };
      });

      /* client circular tabs switching (hover & click) */
      var clientTabs = document.querySelectorAll(".client-circle-btn");
      var clientPanels = document.querySelectorAll(".client-panel");

      function activateClient(clientId) {
        if (!clientId) return;
        clientTabs.forEach(function (tab) {
          var isMatch = tab.getAttribute("data-client-id") === clientId;
          tab.classList.toggle("active", isMatch);
          tab.setAttribute("aria-selected", isMatch ? "true" : "false");
        });
        clientPanels.forEach(function (panel) {
          var isMatch = panel.getAttribute("data-client-id") === clientId;
          panel.classList.toggle("active", isMatch);
        });
      }

      clientTabs.forEach(function (tab) {
        var id = tab.getAttribute("data-client-id");
        if (!id) return;

        // Click / tap works on all devices
        tab.addEventListener("click", function () {
          activateClient(id);
          try {
            tab.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
          } catch (e) {}
        });

        // Hover works on desktop
        tab.addEventListener("mouseenter", function () {
          if (!isTouch) {
            activateClient(id);
          }
        });
      });

      /* dynamic navbar links & top-left logo on scroll */
      var mainNavLogo = $("mainNavLogo");
      var navVault = $("navVault");
      var navGacha = $("navGacha");
      var workSec = $("work");
      var gachaSec = $("gacha");

      function updateNavScroll() {
        if (!workSec || !gachaSec) return;
        var workRect = workSec.getBoundingClientRect();
        var gachaRect = gachaSec.getBoundingClientRect();

        // Top-left XYRO logo appears when user scrolls to/past Vault, disappears at top
        if (mainNavLogo) {
          var showLogo = workRect.top <= 140 || window.scrollY > 150;
          if (showLogo) {
            mainNavLogo.style.opacity = "1";
            mainNavLogo.style.pointerEvents = "auto";
            mainNavLogo.style.transform = "translateY(0)";
          } else {
            mainNavLogo.style.opacity = "0";
            mainNavLogo.style.pointerEvents = "none";
            mainNavLogo.style.transform = "translateY(-8px)";
          }
        }

        // When scrolled past/below the Vault section
        if (workRect.bottom < 80) {
          if (navVault && navVault.style.display !== "inline-block")
            navVault.style.display = "inline-block";
        } else {
          if (navVault && navVault.style.display !== "none")
            navVault.style.display = "none";
        }

        // When scrolled past/below the Gacha section
        if (gachaRect.bottom < 80) {
          if (navGacha && navGacha.style.display !== "inline-block")
            navGacha.style.display = "inline-block";
        } else {
          if (navGacha && navGacha.style.display !== "none")
            navGacha.style.display = "none";
        }
      }

      window.addEventListener("scroll", updateNavScroll, { passive: true });
      updateNavScroll();

      /* Section position tracking & auto-restoration on refresh */
      var secIds = ["work", "gacha", "deal", "contact"];
      var sectionEls = secIds.map(function (id) { return $(id); }).filter(Boolean);

      // Track active section as user scrolls
      if ("IntersectionObserver" in window) {
        var secObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting && entry.intersectionRatio >= 0.25) {
              var id = entry.target.id;
              try {
                sessionStorage.setItem("xyro_last_section", id);
                if (history.replaceState) {
                  history.replaceState(null, "", "#" + id);
                }
              } catch (e) {}
            }
          });
        }, { threshold: [0.25, 0.5] });

        sectionEls.forEach(function (el) { secObserver.observe(el); });
      }

      // If user scrolls back to top (hero)
      window.addEventListener("scroll", function () {
        if (window.scrollY < 150) {
          try {
            sessionStorage.removeItem("xyro_last_section");
            if (window.location.hash && history.replaceState) {
              history.replaceState(null, "", window.location.pathname);
            }
          } catch (e) {}
        }
      }, { passive: true });

      // Auto-restore section on page load / refresh
      function restoreSection() {
        var hash = window.location.hash ? window.location.hash.replace("#", "") : "";
        var savedSec = "";
        try {
          savedSec = sessionStorage.getItem("xyro_last_section") || "";
        } catch (e) {}

        var targetId = hash || savedSec;
        if (targetId && targetId !== "home" && targetId !== "t") {
          var targetEl = $(targetId);
          if (targetEl) {
            setTimeout(function () {
              targetEl.scrollIntoView({ behavior: "instant", block: "start" });
              updateNavScroll();
            }, 60);
          }
        }
      }

      restoreSection();

      // Clean up intro flash from DOM after animation completes
      var introFlashEl = $("introFlash");
      if (introFlashEl) {
        setTimeout(function () {
          introFlashEl.remove();
        }, 900);
      }

      vd();
    </script>
  </body>
</html>
