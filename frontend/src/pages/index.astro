---
export const prerender = true;
import "../styles/global.css";
import {
  urlFor,
  fetchVaultData,
  fetchHomeVault,
  fetchTestimonials,
  fetchFeaturedManga,
} from "../utils/sanity.js";
import Footer from "../components/Footer.astro";

const vaultData = await fetchVaultData();
const homeVaultItems = await fetchHomeVault();
const reviews = await fetchTestimonials();
const mangaList = await fetchFeaturedManga();

// Group testimonials by client (show client profile once with their project reviews below)
const clientGroupsMap = new Map();

reviews.forEach((r: any) => {
  const clientId = r.client?._id || `client-${r.client?.name || "collector"}`;
  const clientName = r.client?.name || "Collector";
  const clientAvatar = r.client?.avatar || null;
  const clientSince = r.client?.clientSince || null;

  if (!clientGroupsMap.has(clientId)) {
    clientGroupsMap.set(clientId, {
      id: clientId,
      name: clientName,
      avatar: clientAvatar,
      clientSince: clientSince,
      reviews: []
    });
  }

  clientGroupsMap.get(clientId).reviews.push(r);
});

const clientGroups = Array.from(clientGroupsMap.values());
clientGroups.sort((a: any, b: any) => b.reviews.length - a.reviews.length);

clientGroups.forEach((group: any) => {
  let sinceText = group.clientSince;
  if (!sinceText) {
    const dates = group.reviews
      .map((r: any) => r.reviewDate || r._createdAt)
      .filter(Boolean)
      .map((d: string) => new Date(d));
    if (dates.length > 0) {
      const oldestDate = new Date(Math.min(...dates.map((d: Date) => d.getTime())));
      sinceText = oldestDate.toLocaleDateString("en-US", { month: "long", year: "numeric" });
    }
  }

  const projectCount = group.reviews.length;
  const projectText = projectCount === 1 ? "1 project" : `${projectCount} projects`;
  group.badgeText = sinceText ? `Client since ${sinceText} • ${projectText}` : projectText;
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>Xyro</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=4" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="icon" href="/favicon.ico?v=4" />
    <link
      href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- OPENING INTRO FLASH -->
    <div id="introFlash" class="intro-flash-overlay" aria-hidden="true">
      <div class="intro-flash-logo"></div>
    </div>

    <div id="bar"></div>
    <div id="cur"></div>

    <div class="top">
      <a
        class="logo lg"
        id="mainNavLogo"
        href="#t"
        aria-label="XYRO home"
        style="opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity .25s ease,transform .25s ease;"
      ></a>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <a
          id="navVault"
          class="pill"
          href="#work"
          style="display:none;text-decoration:none;">Vault</a
        >
        <a
          id="navGacha"
          class="pill"
          href="#gacha"
          style="display:none;text-decoration:none;">Gacha</a
        >
        <button class="pill" id="tg" aria-label="Toggle theme">◐</button>
        <a class="pill" id="bk" href="#contact">Book a slot</a>
      </div>
    </div>

    <div class="hero" id="t">
      <div class="hero-center">
        <span class="lg hero-lg"></span>
        <p>manga · characters · 3D</p>
      </div>
      <span class="sfx" style="left:6%;top:22%;--r:-8deg">ドン!</span>
    </div>

    <div class="mq" aria-hidden="true">
      <div>
        MANGA ✦ 3D ✦ CHARACTERS ✦ ANIMATION ✦ OPEN FOR COMMISSIONS ✦ MANGA ✦ 3D
        ✦ CHARACTERS ✦ ANIMATION ✦ OPEN FOR COMMISSIONS ✦
      </div>
    </div>

    <section id="work">
      <h2>The <em>vault</em></h2>
      <p>
        Hover a piece to bring it to colour. On a phone, scroll it into view or
        tap it.
      </p>
      <div class="vgrid" id="vg">
        {
          homeVaultItems.map((d: any) => (
            <button class="vi" type="button" aria-label={`Preview ${d.t}`}>
              <div class="vc">
                <span class="vy">{d.y}</span>
                <div class="vt" style={`--h:${d.h};--r:${d.r};`}>
                  {d.img ? (
                    <img src={d.img} alt={d.t} loading="lazy" />
                  ) : (
                    <b>{d.t}</b>
                  )}
                </div>
                <div class="vm">{d.g.join(" · ")}</div>
              </div>
            </button>
          ))
        }
      </div>
      <div style="text-align:center;margin-top:40px;">
        <a
          href="/vault"
          class="pill big"
          style="font-size:22px;padding:16px 36px;display:inline-flex;align-items:center;gap:12px;text-decoration:none;box-shadow:6px 6px 0 var(--ink);"
        >
          Vault <span style="font-size:26px;">→</span>
        </a>
      </div>
    </section>

    <dialog id="lb" aria-label="Artwork preview">
      <div class="lbx">
        <button class="lb-close" id="cl" aria-label="Close preview">✕</button>
        <div class="vt lbt" id="lt"></div>
      </div>
    </dialog>

    {mangaList && mangaList.length > 0 && (
      <section id="manga">
        <h2>Featured <em>manga</em></h2>
        <p>Original stories & serialized chapters crafted frame by frame.</p>
        <div class="manga-showcase">
          {mangaList.map((m: any) => {
            const coverUrl = m.coverImage ? urlFor(m.coverImage.asset || m.coverImage).width(800).auto("format").url() : null;
            return (
              <div class="manga-box">
                <div class="manga-cover-wrap">
                  {coverUrl ? (
                    <img src={coverUrl} alt={m.title} class="manga-cover-img" loading="lazy" />
                  ) : (
                    <div class="manga-cover-placeholder">MANGA</div>
                  )}
                  <span class="manga-badge">{m.status || "Completed"}</span>
                </div>
                <div class="manga-info">
                  <div class="manga-tags">
                    <span class="manga-tag">{m.tag || "Manga"}</span>
                    {m.genre && <span class="manga-tag">{m.genre}</span>}
                    {m.pageCount && <span class="manga-tag">{m.pageCount} Pages</span>}
                    {m.subtitle && <span class="manga-tag">{m.subtitle}</span>}
                  </div>
                  <h3 class="manga-title">{m.title}</h3>
                  <p class="manga-desc">
                    A dark fantasy comic commissioned by VStrife. Follow the forbidden rites and molecular transmutations in this high-octane 11-page oneshot.
                  </p>
                  <div>
                    <a href={`/manga/${m.slug}`} class="pill big" style="font-size:20px;padding:14px 32px;display:inline-flex;align-items:center;gap:10px;text-decoration:none;box-shadow:6px 6px 0 var(--ink);">
                      Read Chapter <span style="font-size:24px;">→</span>
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- ===== GACHA V2 MARKUP ===== -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="xl" viewBox="0 0 1089 982">
