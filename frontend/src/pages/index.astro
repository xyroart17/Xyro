    <section id="gacha">
      <div class="gac">
        <span class="lg spin" aria-hidden="true"><svg viewBox="0 0 1089 982"><use href="#xl"/></svg></span>
        <div class="ghead">
          <h2>Roll a commission</h2>
          <p class="gsub"><b id="gn"></b> combos. Roll a new OC, or type any series, game or character. Press <b>R</b>.</p>
          <button class="pill gtb" id="gtb">? How it works</button>
        </div>
        <div class="gwrap">
          <div class="gleft">
            <label class="gl">Series, game or character
              <span class="gser">
                <input id="gss" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="gsg" maxlength="60" placeholder="Naruto, Zelda, Gojo… or leave empty">
                <ul id="gsg" role="listbox" hidden></ul>
              </span>
            </label>
            <div class="gmsg" id="gst" aria-live="polite"></div>
            <div class="gl">Genre
              <div class="ggen" id="gg" role="group" aria-label="Genres"></div>
            </div>
            <div class="gbt">
              <button class="big" id="roll">ROLL</button>
              <button class="big sm" id="rl10">×10</button>
              <button class="pill gp" id="gs">Send →</button>
            </div>
          </div>
          <div>
            <div class="gcard" id="gc">
              <div class="gtop">
                <span class="grar" id="gr">Common</span>
                <small id="gct">Roll #0</small>
              </div>
              <div class="gname">
                <span class="ocb" id="goc">OC</span>
                <span id="gnm">Press roll</span>
                <span class="sr" id="gsr"></span>
                <button class="lk" id="lkn" aria-pressed="false" aria-label="Lock name" style="position:static">🔒</button>
              </div>
              <div class="gch" id="gch"></div>
            </div>
            <div class="g10" id="g10" hidden></div>
            <div class="ghist" id="gh" aria-label="Roll history"></div>
          </div>
        </div>
      </div>
    </section>

    <dialog id="gtut" aria-label="How the roll works">
      <div class="tut">
        <button class="tux" id="tux" aria-label="Close tutorial">✕</button>
        <div id="tbody"></div>
        <div class="tdots" id="tdots"></div>
        <div class="tnav">
          <button class="pill" id="tbk">← Back</button>
          <button class="pill tskip" id="tsk">Skip</button>
          <button class="pill" id="tnx">Next →</button>
        </div>
      </div>
    </dialog>
    <!-- ===== END GACHA V2 MARKUP ===== -->

    <section id="deal">
      <h2>Pick a <em>tier</em></h2>
      <div class="pn">
        <div class="pnl">
          <span class="dg">1</span><h3>Headshot</h3><div class="price">
            $80+
          </div><p>2–4 days. Fully rendered portrait, 2 revisions.</p>
        </div>
        <div class="pnl">
          <span class="dg">2</span><h3>Full body</h3><div class="price">
            $320+
          </div><p>6–9 days. Full character, background, 3 revisions.</p>
        </div>
        <div class="pnl">
          <span class="dg">3</span><h3>Original character sheet</h3><div
            class="price"
          >
            $500+
          </div><p>Multi-view turnaround, expressions & details.</p>
        </div>
      </div>
      <p style="margin-top:22px;font-weight:700">
        Pay 50% to start, 50% before the final file.
      </p>
      <p style="margin-top:6px;font-weight:700;font-size:16px;">
        Price may vary or change.
      </p>
    </section>

    {clientGroups && clientGroups.length > 0 && (
      <section id="reviews">
        <h2>What they <em>say</em></h2>
        <p>Direct feedback from commissioners & directors.</p>

        {/* Horizontal Track of Circular Client Pfps */}
        <div class="client-circles-bar" role="tablist" aria-label="Clients">
          {clientGroups.map((group: any, idx: number) => {
            const clientAvatarUrl = group.avatar
              ? urlFor(group.avatar).width(160).auto("format").url()
              : null;
            return (
              <button
                type="button"
                role="tab"
                class={`client-circle-btn ${idx === 0 ? "active" : ""}`}
                data-client-id={group.id}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`client-panel-${group.id}`}
                id={`client-tab-${group.id}`}
                title={`View ${group.name}'s reviews`}
              >
                <div class="client-circle-pfp-wrap">
                  {clientAvatarUrl ? (
                    <img
                      src={clientAvatarUrl}
                      alt={group.name}
                      class="client-circle-pfp"
                      loading="lazy"
                    />
                  ) : (
                    <div class="client-circle-pfp client-initials">
                      {group.name.charAt(0)}
                    </div>
                  )}
                  <span class="client-circle-count" aria-label={`${group.reviews.length} reviews`}>
                    {group.reviews.length}
                  </span>
                </div>
                <div class="client-circle-meta">
                  <span class="client-circle-name">{group.name}</span>
                  <span class="client-circle-sub">
                    {group.reviews.length === 1 ? "1 review" : `${group.reviews.length} reviews`}
                  </span>
                </div>
              </button>
            );
          })}
        </div>

        {/* Client Review Panels (one visible at a time) */}
        <div class="client-panels-wrap">
          {clientGroups.map((group: any, idx: number) => {
            const clientAvatarUrl = group.avatar ? urlFor(group.avatar).width(160).auto("format").url() : null;
            return (
              <div
                id={`client-panel-${group.id}`}
                class={`client-panel ${idx === 0 ? "active" : ""}`}
                role="tabpanel"
                data-client-id={group.id}
                aria-labelledby={`client-tab-${group.id}`}
              >
                <div class={`client-group count-${Math.min(group.reviews.length, 4)}`}>
                  <div class="client-header">
                    <div class="client-profile">
                      {clientAvatarUrl ? (
                        <img src={clientAvatarUrl} alt={group.name} class="client-avatar" />
                      ) : (
                        <div class="client-avatar client-initials">{group.name.charAt(0)}</div>
                      )}
                      <div>
                        <h3 class="client-name">{group.name}</h3>
                        <span class="client-badge">{group.badgeText}</span>
                      </div>
                    </div>
                  </div>

                  <div class="rev-grid">
                    {group.reviews.map((r: any) => {
                      const tag = r.clientTitle || (r.manga ? "Manga" : "Commission");
                      const workTitle = r.project?.title || r.manga?.title;
                      const workImage = r.cardImage ? urlFor(r.cardImage.asset || r.cardImage).width(200).auto("format").url() :
                        (r.project?.mainImage ? urlFor(r.project.mainImage.asset || r.project.mainImage).width(200).auto("format").url() :
                        (r.manga?.coverImage ? urlFor(r.manga.coverImage.asset || r.manga.coverImage).width(200).auto("format").url() : null));
                      const workFullImage = r.cardImage ? urlFor(r.cardImage.asset || r.cardImage).width(1400).auto("format").url() :
                        (r.project?.mainImage ? urlFor(r.project.mainImage.asset || r.project.mainImage).width(1400).auto("format").url() :
                        (r.manga?.coverImage ? urlFor(r.manga.coverImage.asset || r.manga.coverImage).width(1400).auto("format").url() : null));
                      const cleanQuote = (r.quote || "").replace(/^["'“”]+|["'“”]+$/g, "").trim();

                      return (
                        <div class="rev-card">
                          <div class="rev-card-top">
                            <span class="rev-role">{tag}</span>
                            {workImage && workFullImage && (
                              <button
                                type="button"
                                class="rev-thumb-btn"
                                data-fullimg={workFullImage}
                                data-title={workTitle}
                                aria-label={`Preview ${workTitle}`}
                              >
                                <img src={workImage} alt={workTitle || "Commissioned artwork"} class="rev-thumb" />
                              </button>
                            )}
                          </div>
                          <blockquote class="rev-quote">
                            “{cleanQuote}”
                          </blockquote>
                          {workTitle && (
                            <div class="rev-footer">
                              <span class="rev-work-label">Commission:</span>
                              <button
                                type="button"
                                class="rev-work-title-btn"
                                data-fullimg={workFullImage}
                                data-title={workTitle}
                              >
                                {workTitle} <span style="font-size:13px">🔍</span>
                              </button>
                              {r.manga && (
                                <a href={`/manga/${r.manga.slug}`} class="rev-manga-link">Read Manga →</a>
                              )}
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <section id="contact">
      <h2>Send it <em>in</em></h2>
      <form id="contactForm" class="mail" novalidate>
        <input
          id="mn"
          name="name"
          type="text"
          required
          placeholder="Your name or handle"
          aria-label="Your name or handle"
          autocomplete="name"
        />
        <input
          id="me"
          name="email"
          type="email"
          required
          placeholder="Your email (so Xyro can reply to you)"
          aria-label="Your email address"
          autocomplete="email"
        />
        <textarea
          id="mm"
          name="message"
          rows="5"
          required
          placeholder="What do you want drawn? Roll above to fill this in."
          aria-label="Brief"
        ></textarea>

        <button
          type="submit"
          id="btnSubmitBrief"
          class="contact-submit-btn"
        >
          <span id="submitBtnText">Send Commission Brief</span>
          <span id="submitBtnIcon">→</span>
        </button>

        <div id="contactStatus" class="contact-status-box" style="display:none;" role="status"></div>

        <div class="contact-direct-line">
          <span>Prefer direct email?</span>
          <a href="mailto:officialxyroart@gmail.com" class="contact-direct-link">officialxyroart@gmail.com</a>
          <button type="button" id="btnCopyEmail" class="copy-email-badge" title="Copy email address">
            <span id="copyEmailLabel">Copy</span>
          </button>
        </div>
      </form>
    </section>

    <Footer isHomepage={true} />

    <script
      id="vault-data"
      type="application/json"
      set:html={JSON.stringify(homeVaultItems)}
    />

    <script is:inline>
      var $ = function (i) {
        return document.getElementById(i);
      };

      var isTouch =
        matchMedia("(hover: none)").matches ||
        matchMedia("(pointer: coarse)").matches ||
        window.innerWidth < 768;

      /* cursor tracking & hero */
      var cu = $("cur");
      var h = document.querySelector(".hero");
      if (!isTouch) {
        window.addEventListener("pointermove", function (e) {
          if (cu)
            cu.style.transform =
              "translate(" + (e.clientX - 17) + "px," + (e.clientY - 17) + "px)";
        });

        document.addEventListener("pointerover", function (e) {
          var a = e.target.closest("a,button");
          if (cu) cu.style.width = cu.style.height = a ? "64px" : "34px";
        });
      }

      window.addEventListener("scroll", function () {
        var d = document.documentElement;
        var b = $("bar");
        if (b)
          b.style.width =
            (scrollY / (d.scrollHeight - innerHeight)) * 100 + "%";
      });

      /* ===== GACHA V2 ===== */
      var XYRO_GACHA = {
        email: "officialxyroart@gmail.com",
        onSend: function (text) {
          var m = document.getElementById("mm");
          if (m) {
            m.value = text;
            m.dispatchEvent(new Event("input", { bubbles: true }));
            var c = document.getElementById("contact");
            if (c) c.scrollIntoView({ behavior: "smooth" });
          } else {
            location.href = "mailto:" + this.email + "?subject=" + encodeURIComponent("Commission brief") + "&body=" + encodeURIComponent(text);
          }
        }
      };

      function shake() {
        document.body.classList.remove("xshake");
        void document.body.offsetWidth;
        document.body.classList.add("xshake");
      }

      (function () {
        var P = {
          what: ["Character design", "Manga page", "Key visual poster", "3D scene", "Character sheet", "Chibi set", "Cover illustration", "Duo portrait", "Group shot", "Mascot design", "Environment concept", "Animation test"],
