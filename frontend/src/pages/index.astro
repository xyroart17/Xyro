---
export const prerender = true;
import "../styles/global.css";
import {
  urlFor,
  fetchVaultData,
  fetchHomeVault,
  fetchTestimonials,
  fetchFeaturedManga,
} from "../utils/sanity.js";
import Footer from "../components/Footer.astro";

const vaultData = await fetchVaultData();
const homeVaultItems = await fetchHomeVault();
const reviews = await fetchTestimonials();
const mangaList = await fetchFeaturedManga();

// Group testimonials by client (show client profile once with their project reviews below)
const clientGroupsMap = new Map();

reviews.forEach((r: any) => {
  const clientId = r.client?._id || `client-${r.client?.name || "collector"}`;
  const clientName = r.client?.name || "Collector";
  const clientAvatar = r.client?.avatar || null;
  const clientSince = r.client?.clientSince || null;

  if (!clientGroupsMap.has(clientId)) {
    clientGroupsMap.set(clientId, {
      id: clientId,
      name: clientName,
      avatar: clientAvatar,
      clientSince: clientSince,
      reviews: []
    });
  }

  clientGroupsMap.get(clientId).reviews.push(r);
});

const clientGroups = Array.from(clientGroupsMap.values());
clientGroups.sort((a: any, b: any) => b.reviews.length - a.reviews.length);

clientGroups.forEach((group: any) => {
  let sinceText = group.clientSince;
  if (!sinceText) {
    const dates = group.reviews
      .map((r: any) => r.reviewDate || r._createdAt)
      .filter(Boolean)
      .map((d: string) => new Date(d));
    if (dates.length > 0) {
      const oldestDate = new Date(Math.min(...dates.map((d: Date) => d.getTime())));
      sinceText = oldestDate.toLocaleDateString("en-US", { month: "long", year: "numeric" });
    }
  }

  const projectCount = group.reviews.length;
  const projectText = projectCount === 1 ? "1 project" : `${projectCount} projects`;
  group.badgeText = sinceText ? `Client since ${sinceText} • ${projectText}` : projectText;
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>Xyro</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=4" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="icon" href="/favicon.ico?v=4" />
    <link
      href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="bar"></div>
    <div id="cur"></div>

    <div class="top">
      <a
        class="logo lg"
        id="mainNavLogo"
        href="#t"
        aria-label="XYRO home"
        style="opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity .25s ease,transform .25s ease;"
      ></a>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <a
          id="navVault"
          class="pill"
          href="#work"
          style="display:none;text-decoration:none;">Vault</a
        >
        <a
          id="navGacha"
          class="pill"
          href="#gacha"
          style="display:none;text-decoration:none;">Gacha</a
        >
        <button class="pill" id="tg" aria-label="Toggle theme">◐</button>
        <a class="pill" id="bk" href="#contact">Book a slot</a>
      </div>
    </div>

    <div class="hero" id="t">
      <div class="hero-center">
        <span class="lg hero-lg"></span>
        <p>manga · characters · 3D</p>
      </div>
      <span class="sfx" style="left:6%;top:22%;--r:-8deg">ドン!</span>
    </div>

    <div class="mq" aria-hidden="true">
      <div>
        MANGA ✦ 3D ✦ CHARACTERS ✦ ANIMATION ✦ OPEN FOR COMMISSIONS ✦ MANGA ✦ 3D
        ✦ CHARACTERS ✦ ANIMATION ✦ OPEN FOR COMMISSIONS ✦
      </div>
    </div>

    <section id="work">
      <h2>The <em>vault</em></h2>
      <p>
        Hover a piece to bring it to colour. On a phone, scroll it into view or
        tap it.
      </p>
      <div class="vgrid" id="vg">
        {
          homeVaultItems.map((d: any) => (
            <button class="vi" type="button" aria-label={`Preview ${d.t}`}>
              <div class="vc">
                <span class="vy">{d.y}</span>
                <div class="vt" style={`--h:${d.h};--r:${d.r};`}>
                  {d.img ? (
                    <img src={d.img} alt={d.t} loading="lazy" />
                  ) : (
                    <b>{d.t}</b>
                  )}
                </div>
                <div class="vm">{d.g.join(" · ")}</div>
              </div>
            </button>
          ))
        }
      </div>
      <div style="text-align:center;margin-top:40px;">
        <a
          href="/vault"
          class="pill big"
          style="font-size:22px;padding:16px 36px;display:inline-flex;align-items:center;gap:12px;text-decoration:none;box-shadow:6px 6px 0 var(--ink);"
        >
          Vault <span style="font-size:26px;">→</span>
        </a>
      </div>
    </section>

    <dialog id="lb" aria-label="Artwork preview">
      <div class="lbx">
        <button class="lb-close" id="cl" aria-label="Close preview">✕</button>
        <div class="vt lbt" id="lt"></div>
      </div>
    </dialog>

    {mangaList && mangaList.length > 0 && (
      <section id="manga">
        <h2>Featured <em>manga</em></h2>
        <p>Original stories & serialized chapters crafted frame by frame.</p>
        <div class="manga-showcase">
          {mangaList.map((m: any) => {
            const coverUrl = m.coverImage ? urlFor(m.coverImage.asset || m.coverImage).width(800).auto("format").url() : null;
            return (
              <div class="manga-box">
                <div class="manga-cover-wrap">
                  {coverUrl ? (
                    <img src={coverUrl} alt={m.title} class="manga-cover-img" loading="lazy" />
                  ) : (
                    <div class="manga-cover-placeholder">MANGA</div>
                  )}
                  <span class="manga-badge">{m.status || "Completed"}</span>
                </div>
                <div class="manga-info">
                  <div class="manga-tags">
                    <span class="manga-tag">{m.tag || "Manga"}</span>
                    {m.genre && <span class="manga-tag">{m.genre}</span>}
                    {m.pageCount && <span class="manga-tag">{m.pageCount} Pages</span>}
                    {m.subtitle && <span class="manga-tag">{m.subtitle}</span>}
                  </div>
                  <h3 class="manga-title">{m.title}</h3>
                  <p class="manga-desc">
                    A dark fantasy comic commissioned by VStrife. Follow the forbidden rites and molecular transmutations in this high-octane 11-page oneshot.
                  </p>
                  <div>
                    <a href={`/manga/${m.slug}`} class="pill big" style="font-size:20px;padding:14px 32px;display:inline-flex;align-items:center;gap:10px;text-decoration:none;box-shadow:6px 6px 0 var(--ink);">
                      Read Chapter <span style="font-size:24px;">→</span>
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <section id="gacha">
      <div class="gac">
        <span class="lg spin" aria-hidden="true"></span>
        <h2 style="margin:0 0 10px">Roll a commission</h2>
        <p>
          No idea what to order? Spin for a brief, then send it to me in one
          click.
        </p>
        <div class="reels">
          <div class="reel" id="r1"><small>what</small>?</div>
          <div class="reel" id="r2"><small>style</small>?</div>
          <div class="reel" id="r3"><small>mood</small>?</div>
        </div>
        <button class="big" id="roll">ROLL!</button>
        <div class="res" id="res"></div>
      </div>
    </section>

    <section id="deal">
      <h2>Pick a <em>tier</em></h2>
      <div class="pn">
        <div class="pnl">
          <span class="dg">1</span><h3>Headshot</h3><div class="price">
            $80+
          </div><p>2–4 days. Fully rendered portrait, 2 revisions.</p>
        </div>
        <div class="pnl">
          <span class="dg">2</span><h3>Full body</h3><div class="price">
            $320+
          </div><p>6–9 days. Full character, background, 3 revisions.</p>
        </div>
        <div class="pnl">
          <span class="dg">3</span><h3>Original character sheet</h3><div
            class="price"
          >
            $500+
          </div><p>Multi-view turnaround, expressions & details.</p>
        </div>
      </div>
      <p style="margin-top:22px;font-weight:700">
        Pay 50% to start, 50% before the final file.
      </p>
      <p style="margin-top:6px;font-weight:700;font-size:16px;">
        Price may vary or change.
      </p>
    </section>

    {clientGroups && clientGroups.length > 0 && (
      <section id="reviews">
        <h2>What they <em>say</em></h2>
        <p>Direct feedback from commissioners & directors.</p>

        {/* Horizontal Track of Circular Client Pfps */}
        <div class="client-circles-bar" role="tablist" aria-label="Clients">
          {clientGroups.map((group: any, idx: number) => {
            const clientAvatarUrl = group.avatar
              ? urlFor(group.avatar).width(160).auto("format").url()
              : null;
            return (
              <button
                type="button"
                role="tab"
                class={`client-circle-btn ${idx === 0 ? "active" : ""}`}
                data-client-id={group.id}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`client-panel-${group.id}`}
                id={`client-tab-${group.id}`}
                title={`View ${group.name}'s reviews`}
              >
                <div class="client-circle-pfp-wrap">
                  {clientAvatarUrl ? (
                    <img
                      src={clientAvatarUrl}
                      alt={group.name}
                      class="client-circle-pfp"
                      loading="lazy"
                    />
                  ) : (
                    <div class="client-circle-pfp client-initials">
                      {group.name.charAt(0)}
                    </div>
                  )}
                  <span class="client-circle-count" aria-label={`${group.reviews.length} reviews`}>
                    {group.reviews.length}
                  </span>
                </div>
                <div class="client-circle-meta">
                  <span class="client-circle-name">{group.name}</span>
                  <span class="client-circle-sub">
                    {group.reviews.length === 1 ? "1 review" : `${group.reviews.length} reviews`}
                  </span>
                </div>
              </button>
            );
          })}
        </div>

        {/* Client Review Panels (one visible at a time) */}
        <div class="client-panels-wrap">
          {clientGroups.map((group: any, idx: number) => {
            const clientAvatarUrl = group.avatar ? urlFor(group.avatar).width(160).auto("format").url() : null;
            return (
              <div
                id={`client-panel-${group.id}`}
                class={`client-panel ${idx === 0 ? "active" : ""}`}
                role="tabpanel"
                data-client-id={group.id}
                aria-labelledby={`client-tab-${group.id}`}
              >
                <div class={`client-group count-${Math.min(group.reviews.length, 4)}`}>
                  <div class="client-header">
                    <div class="client-profile">
                      {clientAvatarUrl ? (
                        <img src={clientAvatarUrl} alt={group.name} class="client-avatar" />
                      ) : (
                        <div class="client-avatar client-initials">{group.name.charAt(0)}</div>
                      )}
                      <div>
                        <h3 class="client-name">{group.name}</h3>
                        <span class="client-badge">{group.badgeText}</span>
                      </div>
                    </div>
                  </div>

                  <div class="rev-grid">
                    {group.reviews.map((r: any) => {
                      const tag = r.clientTitle || (r.manga ? "Manga" : "Commission");
                      const workTitle = r.project?.title || r.manga?.title;
                      const workImage = r.cardImage ? urlFor(r.cardImage.asset || r.cardImage).width(200).auto("format").url() :
                        (r.project?.mainImage ? urlFor(r.project.mainImage.asset || r.project.mainImage).width(200).auto("format").url() :
                        (r.manga?.coverImage ? urlFor(r.manga.coverImage.asset || r.manga.coverImage).width(200).auto("format").url() : null));
                      const workFullImage = r.cardImage ? urlFor(r.cardImage.asset || r.cardImage).width(1400).auto("format").url() :
                        (r.project?.mainImage ? urlFor(r.project.mainImage.asset || r.project.mainImage).width(1400).auto("format").url() :
                        (r.manga?.coverImage ? urlFor(r.manga.coverImage.asset || r.manga.coverImage).width(1400).auto("format").url() : null));
                      const cleanQuote = (r.quote || "").replace(/^["'“”]+|["'“”]+$/g, "").trim();

                      return (
                        <div class="rev-card">
                          <div class="rev-card-top">
                            <span class="rev-role">{tag}</span>
                            {workImage && workFullImage && (
                              <button
                                type="button"
                                class="rev-thumb-btn"
                                data-fullimg={workFullImage}
                                data-title={workTitle}
                                aria-label={`Preview ${workTitle}`}
                              >
                                <img src={workImage} alt={workTitle || "Commissioned artwork"} class="rev-thumb" />
                              </button>
                            )}
                          </div>
                          <blockquote class="rev-quote">
                            “{cleanQuote}”
                          </blockquote>
                          {workTitle && (
                            <div class="rev-footer">
                              <span class="rev-work-label">Commission:</span>
                              <button
                                type="button"
                                class="rev-work-title-btn"
                                data-fullimg={workFullImage}
                                data-title={workTitle}
                              >
                                {workTitle} <span style="font-size:13px">🔍</span>
                              </button>
                              {r.manga && (
                                <a href={`/manga/${r.manga.slug}`} class="rev-manga-link">Read Manga →</a>
                              )}
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <section id="contact">
      <h2>Send it <em>in</em></h2>
      <form id="contactForm" class="mail" novalidate>
        <input
          id="mn"
          name="name"
          type="text"
          required
          placeholder="Your name or handle"
          aria-label="Your name or handle"
          autocomplete="name"
        />
        <input
          id="me"
          name="email"
          type="email"
          required
          placeholder="Your email (so Xyro can reply to you)"
          aria-label="Your email address"
          autocomplete="email"
        />
        <textarea
          id="mm"
          name="message"
          rows="5"
          required
          placeholder="What do you want drawn? Roll above to fill this in."
          aria-label="Brief"
        ></textarea>

        <button
          type="submit"
          id="btnSubmitBrief"
          class="contact-submit-btn"
        >
          <span id="submitBtnText">Send Commission Brief</span>
          <span id="submitBtnIcon">→</span>
        </button>

        <div id="contactStatus" class="contact-status-box" style="display:none;" role="status"></div>

        <div class="contact-direct-line">
          <span>Prefer direct email?</span>
          <a href="mailto:officialxyroart@gmail.com" class="contact-direct-link">officialxyroart@gmail.com</a>
          <button type="button" id="btnCopyEmail" class="copy-email-badge" title="Copy email address">
            <span id="copyEmailLabel">Copy</span>
          </button>
        </div>
      </form>
    </section>

    <Footer isHomepage={true} />

    <script
      id="vault-data"
      type="application/json"
      set:html={JSON.stringify(homeVaultItems)}
    />

    <script is:inline>
      var $ = function (i) {
        return document.getElementById(i);
      };

      var isTouch =
        matchMedia("(hover: none)").matches ||
        matchMedia("(pointer: coarse)").matches ||
        window.innerWidth < 768;

      /* cursor tracking & hero */
      var cu = $("cur");
      var h = document.querySelector(".hero");
      if (!isTouch) {
        window.addEventListener("pointermove", function (e) {
          if (cu)
            cu.style.transform =
              "translate(" + (e.clientX - 17) + "px," + (e.clientY - 17) + "px)";
        });

        document.addEventListener("pointerover", function (e) {
          var a = e.target.closest("a,button");
          if (cu) cu.style.width = cu.style.height = a ? "64px" : "34px";
        });
      }

      window.addEventListener("scroll", function () {
        var d = document.documentElement;
        var b = $("bar");
        if (b)
          b.style.width =
            (scrollY / (d.scrollHeight - innerHeight)) * 100 + "%";
      });

      /* gacha */
      var A = [
          [
            "Character design",
            "Manga page",
            "Portrait",
            "3D scene",
            "Full illustration",
          ],
          ["anime cel", "watercolour", "manga ink", "Shinkai sky", "painterly"],
          ["epic", "cozy", "dark", "dreamy", "funny"],
        ],
        cb = "";

      function pick(a) {
        return a[Math.floor(Math.random() * a.length)];
      }

      var rollBtn = $("roll");
      if (rollBtn) {
        rollBtn.onclick = function () {
          var n = 0;
          var id = setInterval(function () {
            for (var i = 0; i < 3; i++) {
              var rEl = $("r" + (i + 1));
              if (rEl) rEl.innerHTML = "<span>" + pick(A[i]) + "</span>";
            }
            if (++n > 12) {
              clearInterval(id);
              var v = [pick(A[0]), pick(A[1]), pick(A[2])];
              for (var i = 0; i < 3; i++) {
                var rEl2 = $("r" + (i + 1));
                if (rEl2) rEl2.innerHTML = "<span>" + v[i] + "</span>";
              }
              cb =
                "I’d like a " +
                v[0] +
                " in a " +
                v[1] +
                " style, with an " +
                v[2] +
                " mood. Details: ";
              var resEl = $("res");
              if (resEl)
                resEl.innerHTML =
                  "<b>" +
                  cb +
                  "</b><br><a href='#contact' style='color:var(--pk);font-weight:700'>Send this to Xyro ↓</a>";
              var mmEl = $("mm");
              if (mmEl) mmEl.value = cb;
            }
          }, 70);
        };
      }

      /* contact form submission & actions */
      var contactForm = $("contactForm");
      var btnSubmit = $("btnSubmitBrief");
      var submitBtnText = $("submitBtnText");
      var submitBtnIcon = $("submitBtnIcon");
      var contactStatus = $("contactStatus");
      var btnCopyEmail = $("btnCopyEmail");
      var copyEmailLabel = $("copyEmailLabel");

      function escapeHtml(str) {
        var div = document.createElement("div");
        div.textContent = str;
        return div.innerHTML;
      }

      function showStatus(type, title, msg) {
        if (!contactStatus) return;
        contactStatus.className = "contact-status-box " + type;
        contactStatus.innerHTML = '<div class="status-title">' + title + '</div><p>' + msg + '</p>';
        contactStatus.style.display = "block";
        contactStatus.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      function resetSubmitBtn() {
        if (btnSubmit) btnSubmit.disabled = false;
        if (submitBtnText) submitBtnText.textContent = "Send Commission Brief";
        if (submitBtnIcon) submitBtnIcon.textContent = "→";
      }

      if (contactForm) {
        contactForm.addEventListener("submit", async function (e) {
          e.preventDefault();

          var nameInput = $("mn");
          var emailInput = $("me");
          var msgInput = $("mm");

          var name = nameInput ? nameInput.value.trim() : "";
          var email = emailInput ? emailInput.value.trim() : "";
          var message = msgInput ? msgInput.value.trim() : "";

          if (!name) {
            showStatus("error", "Notice", "Please enter your name or handle.");
            if (nameInput) nameInput.focus();
            return;
          }

          if (!email) {
            showStatus("error", "Notice", "Please enter your email so Xyro can get back to you.");
            if (emailInput) emailInput.focus();
            return;
          }

          var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(email)) {
            showStatus("error", "Notice", "Please enter a valid email address (e.g. name@domain.com).");
            if (emailInput) emailInput.focus();
            return;
          }

          if (!message) {
            showStatus("error", "Notice", "Please describe what you would like drawn or roll the Gacha above.");
            if (msgInput) msgInput.focus();
            return;
          }

          // Disable button and show sending state
          if (btnSubmit) btnSubmit.disabled = true;
          if (submitBtnText) submitBtnText.textContent = "Sending Brief...";
          if (submitBtnIcon) submitBtnIcon.textContent = "⏳";
          if (contactStatus) contactStatus.style.display = "none";

          try {
            var res = await fetch("/api/contact", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ name: name, email: email, message: message }),
            });

            var data = await res.json().catch(function () { return {}; });

            if (res.ok && data.success) {
              showStatus(
                "success",
                "<span>✓</span> <span>Brief Received!</span>",
                "Thanks, <strong>" + escapeHtml(name) + "</strong>! Xyro has received your brief and will reply to <u>" + escapeHtml(email) + "</u> within 24–48 hours."
              );
              if (submitBtnText) submitBtnText.textContent = "Brief Sent ✓";
              if (submitBtnIcon) submitBtnIcon.textContent = "";
              if (msgInput) msgInput.value = "";
            } else {
              var errMsg = data.error || "Unable to deliver email.";
              showStatus("error", "Submission Error", errMsg + " You can also email officialxyroart@gmail.com directly.");
              resetSubmitBtn();
            }
          } catch (err) {
            console.error("Submission exception:", err);
            var mailtoFallback = "mailto:officialxyroart@gmail.com?subject=" + encodeURIComponent("Commission Brief from " + name) + "&body=" + encodeURIComponent(message + "\n\nClient Email: " + email);
            showStatus(
              "error",
              "Connection Notice",
              "Could not connect to the mail service right now. <a href='" + mailtoFallback + "' style='color:var(--pk);font-weight:700;text-decoration:underline;'>Click here to open in your mail app →</a>"
            );
            resetSubmitBtn();
          }
        });
      }

      function fallbackCopy(text) {
        var ta = document.createElement("textarea");
        ta.value = text;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand("copy");
          showCopiedEmail();
        } catch (err) {}
        document.body.removeChild(ta);
      }

      function showCopiedEmail() {
        if (!copyEmailLabel) return;
        copyEmailLabel.textContent = "Copied! ✓";
        setTimeout(function () {
          copyEmailLabel.textContent = "Copy";
        }, 2000);
      }

      if (btnCopyEmail) {
        btnCopyEmail.addEventListener("click", function (e) {
          e.preventDefault();
          var addr = "officialxyroart@gmail.com";
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(addr).then(showCopiedEmail).catch(function () {
              fallbackCopy(addr);
            });
          } else {
            fallbackCopy(addr);
          }
        });
      }

      /* theme toggle */
      var rDoc = document.documentElement;
      try {
        var savedTheme = localStorage.getItem("xt2");
        if (savedTheme) rDoc.setAttribute("data-theme", savedTheme);
      } catch (x) {}

      var tgBtn = $("tg");
      if (tgBtn) {
        tgBtn.onclick = function () {
          var curTheme =
            rDoc.getAttribute("data-theme") ||
            (matchMedia("(prefers-color-scheme:dark)").matches
              ? "dark"
              : "light");
          var nextTheme = curTheme == "dark" ? "light" : "dark";
          rDoc.setAttribute("data-theme", nextTheme);
          try {
            localStorage.setItem("xt2", nextTheme);
          } catch (x) {}
        };
      }

      /* audio & interaction effects */
      var AC = null,
        snd = true;
      function thud() {
        if (!snd) return;
        try {
          AC = AC || new (window.AudioContext || window.webkitAudioContext)();
          if (AC.state === "suspended") AC.resume();
          var o = AC.createOscillator(),
            g = AC.createGain();
          o.type = "sine";
          o.frequency.setValueAtTime(170, AC.currentTime);
          o.frequency.exponentialRampToValueAtTime(40, AC.currentTime + 0.22);
          g.gain.setValueAtTime(0.7, AC.currentTime);
          g.gain.exponentialRampToValueAtTime(0.001, AC.currentTime + 0.3);
          o.connect(g);
          g.connect(AC.destination);
          o.start();
          o.stop(AC.currentTime + 0.32);
        } catch (x) {}
      }
      window.addEventListener(
        "pointerdown",
        function () {
          try {
            if (!AC)
              AC = new (window.AudioContext || window.webkitAudioContext)();
            if (AC.state === "suspended") AC.resume();
          } catch (e) {}
        },
        { once: true },
      );

      function shake() {
        document.body.classList.remove("shake");
        void document.body.offsetWidth;
        document.body.classList.add("shake");
      }

      if (h && !isTouch) {
        h.addEventListener("pointerdown", function (e) {
          if (e.target.closest("a,button")) return;
          var r = h.getBoundingClientRect(),
            x = e.clientX - r.left,
            y = e.clientY - r.top;
          var s = document.createElement("span");
          s.className = "lg st";
          s.style.left = x + "px";
          s.style.top = y + "px";
          s.style.setProperty("--r", Math.random() * 34 - 17 + "deg");
          var g = document.createElement("span");
          g.className = "ring";
          g.style.left = x + "px";
          g.style.top = y + "px";
          h.appendChild(g);
          h.appendChild(s);
          setTimeout(function () {
            g.remove();
          }, 650);
          var a = h.querySelectorAll(".st");
          if (a.length > 30) a[0].remove();
          thud();
          shake();
        });

        h.addEventListener("pointermove", function (e) {
          var r = h.getBoundingClientRect();
          h.style.setProperty(
            "--px",
            ((e.clientX - r.left) / r.width - 0.5) * -50 + "px",
          );
          h.style.setProperty(
            "--py",
            ((e.clientY - r.top) / r.height - 0.5) * -36 + "px",
          );
        });
      }

      document.addEventListener("pointerover", function (e) {
        var on = !!e.target.closest(".vi");
        if (cu) {
          cu.classList.toggle("lgm", on);
          cu.classList.toggle("lg", on);
        }
      });

      document.addEventListener("pointermove", function (e) {
        var p = e.target.closest && e.target.closest(".pill,.big");
        if (!p) return;
        var r = p.getBoundingClientRect();
        p.style.transform =
          "translate(" +
          (e.clientX - r.left - r.width / 2) * 0.25 +
          "px," +
          (e.clientY - r.top - r.height / 2) * 0.35 +
          "px)";
      });
      document.addEventListener("pointerout", function (e) {
        var p = e.target.closest && e.target.closest(".pill,.big");
        if (p) p.style.transform = "";
      });

      if (rollBtn) {
        var ro = rollBtn.onclick;
        rollBtn.onclick = function () {
          if (ro) ro();
          setTimeout(function () {
            thud();
            shake();
          }, 1050);
        };
      }

      /* vault items & hydration */
      var bkBtn = $("bk");
      if (bkBtn) bkBtn.textContent = "Book a slot";

      var D = [];
      try {
        var vEl = $("vault-data");
        if (vEl) D = JSON.parse(vEl.textContent || "[]");
      } catch (e) {}

      var CT = [
          ["all", "All"],
          ["commission", "Commission"],
          ["original", "Original"],
          ["fanart", "Fan art"],
          ["manga", "Manga"],
          ["3d", "3D"],
          ["digital", "Digital"],
          ["traditional", "Traditional"],
          ["mythology", "Mythology"],
        ],
        cf = "all",
        qq = "",
        vs = [],
        ix = 0;

      function tl(d) {
        return (
          '<div class="vt" style="--h:' +
          d.h +
          ";--r:" +
          d.r +
          '">' +
          (d.img
            ? '<img src="' + d.img + '" alt="' + d.t + '" loading="lazy">'
            : "<b>" + d.t + "</b>") +
          "</div>"
        );
      }

      var io =
        window.IntersectionObserver && matchMedia("(hover:none)").matches
          ? new IntersectionObserver(
              function (es) {
                es.forEach(function (e) {
                  e.target.classList.toggle("on", e.intersectionRatio > 0.6);
                });
              },
              { threshold: [0, 0.6] },
            )
          : null;

      function vd() {
        var g = $("vg");
        if (!g) return;
        vs = D.slice(0, 4);

        var btns = g.querySelectorAll(".vi");
        if (btns.length === vs.length && vs.length > 0) {
          btns.forEach(function (b, n) {
            b.onclick = function () {
              sh(n);
              var lb = $("lb");
              if (lb && typeof lb.showModal === "function") lb.showModal();
            };
            if (io) io.observe(b);
          });
          return;
        }

        g.innerHTML = "";
        vs.forEach(function (d, n) {
          var b = document.createElement("button");
          b.className = "vi";
          b.type = "button";
          b.innerHTML =
            '<div class="vc"><span class="vy">' +
            d.y +
            "</span>" +
            tl(d) +
            '<div class="vm">' +
            d.g.join(" · ") +
            "</div></div>";
          b.onclick = function () {
            sh(n);
            var lb = $("lb");
            if (lb && typeof lb.showModal === "function") lb.showModal();
          };
          g.appendChild(b);
          if (io) io.observe(b);
        });
      }

      function sh(n) {
        var d = vs[n];
        if (!d) return;
        var lt = $("lt");
        if (lt)
          lt.outerHTML = tl(d).replace('class="vt"', 'class="vt lbt" id="lt"');
      }

      if ($("cl"))
        $("cl").onclick = function () {
          var lb = $("lb");
          if (lb) lb.close();
        };

      var lbEl = $("lb");
      if (lbEl) {
        lbEl.addEventListener("click", function (e) {
          if (e.target == lbEl) lbEl.close();
        });
      }

      /* client reviews direct image preview */
      document.querySelectorAll(".rev-thumb-btn, .rev-work-title-btn").forEach(function (btn) {
        btn.onclick = function () {
          var fullImg = btn.getAttribute("data-fullimg");
          var title = btn.getAttribute("data-title") || "Artwork preview";
          if (!fullImg) return;
          var lt = $("lt");
          if (lt) {
            lt.outerHTML = '<div class="vt lbt" id="lt"><img src="' + fullImg + '" alt="' + title + '" loading="lazy"></div>';
          }
          var lb = $("lb");
          if (lb && typeof lb.showModal === "function") lb.showModal();
        };
      });

      /* client circular tabs switching (hover & click) */
      var clientTabs = document.querySelectorAll(".client-circle-btn");
      var clientPanels = document.querySelectorAll(".client-panel");

      function activateClient(clientId) {
        if (!clientId) return;
        clientTabs.forEach(function (tab) {
          var isMatch = tab.getAttribute("data-client-id") === clientId;
          tab.classList.toggle("active", isMatch);
          tab.setAttribute("aria-selected", isMatch ? "true" : "false");
        });
        clientPanels.forEach(function (panel) {
          var isMatch = panel.getAttribute("data-client-id") === clientId;
          panel.classList.toggle("active", isMatch);
        });
      }

      clientTabs.forEach(function (tab) {
        var id = tab.getAttribute("data-client-id");
        if (!id) return;

        // Click / tap works on all devices
        tab.addEventListener("click", function () {
          activateClient(id);
          try {
            tab.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
          } catch (e) {}
        });

        // Hover works on desktop
        tab.addEventListener("mouseenter", function () {
          if (!isTouch) {
            activateClient(id);
          }
        });
      });

      /* dynamic navbar links & top-left logo on scroll */
      var mainNavLogo = $("mainNavLogo");
      var navVault = $("navVault");
      var navGacha = $("navGacha");
      var workSec = $("work");
      var gachaSec = $("gacha");

      function updateNavScroll() {
        if (!workSec || !gachaSec) return;
        var workRect = workSec.getBoundingClientRect();
        var gachaRect = gachaSec.getBoundingClientRect();

        // Top-left XYRO logo appears when user scrolls to/past Vault, disappears at top
        if (mainNavLogo) {
          var showLogo = workRect.top <= 140 || window.scrollY > 150;
          if (showLogo) {
            mainNavLogo.style.opacity = "1";
            mainNavLogo.style.pointerEvents = "auto";
            mainNavLogo.style.transform = "translateY(0)";
          } else {
            mainNavLogo.style.opacity = "0";
            mainNavLogo.style.pointerEvents = "none";
            mainNavLogo.style.transform = "translateY(-8px)";
          }
        }

        // When scrolled past/below the Vault section
        if (workRect.bottom < 80) {
          if (navVault && navVault.style.display !== "inline-block")
            navVault.style.display = "inline-block";
        } else {
          if (navVault && navVault.style.display !== "none")
            navVault.style.display = "none";
        }

        // When scrolled past/below the Gacha section
        if (gachaRect.bottom < 80) {
          if (navGacha && navGacha.style.display !== "inline-block")
            navGacha.style.display = "inline-block";
        } else {
          if (navGacha && navGacha.style.display !== "none")
            navGacha.style.display = "none";
        }
      }

      window.addEventListener("scroll", updateNavScroll, { passive: true });
      updateNavScroll();

      vd();
    </script>
  </body>
</html>
