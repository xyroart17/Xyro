---
export const prerender = true;
import "../styles/global.css";
import { fetchVaultData } from "../utils/sanity.js";
import Footer from "../components/Footer.astro";

const vaultData = await fetchVaultData();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>Xyro — The Vault</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=4" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="icon" href="/favicon.ico?v=4" />
    <link
      href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- OPENING INTRO FLASH -->
    <div id="introFlash" class="intro-flash-overlay" aria-hidden="true">
      <div class="intro-flash-logo"></div>
    </div>

    <div id="bar"></div>
    <div id="cur"></div>

    <!-- FIXED TOP NAVBAR -->
    <div class="top">
      <div style="display:flex;align-items:center;gap:12px;">
        <a class="logo lg" href="/" aria-label="XYRO home"></a>
        <a class="pill" href="/" style="text-decoration:none;font-weight:700;"
          >← Back to Home</a
        >
      </div>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <a class="pill" href="/#gacha" style="text-decoration:none;">Gacha</a>
        <a class="pill" href="/#deal" style="text-decoration:none;">Pricing</a>
        <button class="pill" id="tg" aria-label="Toggle theme">◐</button>
        <a class="pill" id="bk" href="/#contact" style="text-decoration:none;"
          >Book a slot</a
        >
      </div>
    </div>

    <main class="vwrap" id="app">
      <div class="vhead">
        <h1>THE <em>VAULT</em></h1>
        <p>
          Every piece, newest first. Hover one to bring it to colour. On a
          phone, scroll it into view or tap it.
        </p>
      </div>

      <!-- MASONRY GRID (All 34 pieces, uncropped with natural dimensions) -->
      <div class="vgrid" id="vg">
        {
          vaultData.map((d: any) => (
            <button class="vi" type="button" aria-label={`Preview ${d.t}`}>
              <div class="vc">
                <span class="vy">{d.y}</span>
                <div class="vt" style={`--h:${d.h};--r:${d.r};`}>
                  {d.img ? (
                    <img src={d.img} alt={d.t} loading="lazy" />
                  ) : (
                    <b>{d.t}</b>
                  )}
                </div>
                <div class="vm">{d.g.join(" · ")}</div>
              </div>
            </button>
          ))
        }
      </div>
    </main>

    <dialog id="lb" aria-label="Artwork preview">
      <div class="lbx">
        <button class="lb-close" id="cl" aria-label="Close preview">✕</button>
        <div class="vt lbt" id="lt"></div>
      </div>
    </dialog>

    <Footer isHomepage={false} />

    <script
      id="vault-data"
      type="application/json"
      set:html={JSON.stringify(vaultData)}
    />

    <script is:inline>
      var $ = function (i) {
        return document.getElementById(i);
      };

      var D = [];
      try {
        var sEl = $("vault-data");
        if (sEl) D = JSON.parse(sEl.textContent || "[]");
      } catch (e) {}

      var vs = D;

      function tl(d) {
        return (
          '<div class="vt" style="--h:' +
          d.h +
          ";--r:" +
          d.r +
          '">' +
          (d.img
            ? '<img src="' + d.img + '" alt="' + d.t + '" loading="lazy">'
            : "<b>" + d.t + "</b>") +
          "</div>"
        );
      }

      var io =
        window.IntersectionObserver && matchMedia("(hover:none)").matches
          ? new IntersectionObserver(
              function (es) {
                es.forEach(function (e) {
                  e.target.classList.toggle("on", e.intersectionRatio > 0.6);
                });
              },
              { threshold: [0, 0.6] },
            )
          : null;

      function renderGrid() {
        var g = $("vg");
        if (!g) return;
        vs = D;

        var btns = g.querySelectorAll(".vi");
        if (btns.length === vs.length && vs.length > 0) {
          btns.forEach(function (b, n) {
            b.onclick = function () {
              sh(n);
              var lb = $("lb");
              if (lb && typeof lb.showModal === "function") lb.showModal();
            };
            if (io) io.observe(b);
          });
          return;
        }

        g.innerHTML = "";
        vs.forEach(function (d, n) {
          var b = document.createElement("button");
          b.className = "vi";
          b.type = "button";
          b.innerHTML =
            '<div class="vc"><span class="vy">' +
            d.y +
            "</span>" +
            tl(d) +
            '<div class="vm">' +
            d.g.join(" · ") +
            "</div></div>";
          b.onclick = function () {
            sh(n);
            var lb = $("lb");
            if (lb && typeof lb.showModal === "function") lb.showModal();
          };
          g.appendChild(b);
          if (io) io.observe(b);
        });
      }

      function sh(n) {
        var d = vs[n];
        if (!d) return;
        var lt = $("lt");
        if (lt)
          lt.outerHTML = tl(d).replace('class="vt"', 'class="vt lbt" id="lt"');
      }

      if ($("cl"))
        $("cl").onclick = function () {
          var lb = $("lb");
          if (lb) lb.close();
        };

      var lbEl = $("lb");
      if (lbEl) {
        lbEl.addEventListener("click", function (e) {
          if (e.target == lbEl) lbEl.close();
        });
      }

      /* cursor & progress */
      var cu = $("cur");
      window.addEventListener("pointermove", function (e) {
        if (cu)
          cu.style.transform =
            "translate(" + (e.clientX - 17) + "px," + (e.clientY - 17) + "px)";
      });
      document.addEventListener("pointerover", function (e) {
        if (cu)
          cu.style.width = cu.style.height = e.target.closest("a,button")
            ? "64px"
            : "34px";
      });
      window.addEventListener("scroll", function () {
        var d = document.documentElement;
        var b = $("bar");
        if (b)
          b.style.width =
            (scrollY / (d.scrollHeight - innerHeight)) * 100 + "%";
      });

      /* theme toggle */
      var rDoc = document.documentElement;
      try {
        var savedTheme = localStorage.getItem("xt2");
        if (savedTheme) rDoc.setAttribute("data-theme", savedTheme);
      } catch (x) {}

      var tgBtn = $("tg");
      if (tgBtn) {
        tgBtn.onclick = function () {
          var curTheme =
            rDoc.getAttribute("data-theme") ||
            (matchMedia("(prefers-color-scheme:dark)").matches
              ? "dark"
              : "light");
          var nextTheme = curTheme == "dark" ? "light" : "dark";
          rDoc.setAttribute("data-theme", nextTheme);
          try {
            localStorage.setItem("xt2", nextTheme);
          } catch (x) {}
        };
      }

      /* magnetic buttons */
      document.addEventListener("pointermove", function (e) {
        var p = e.target.closest && e.target.closest(".pill,.big");
        if (!p) return;
        var r = p.getBoundingClientRect();
        p.style.transform =
          "translate(" +
          (e.clientX - r.left - r.width / 2) * 0.25 +
          "px," +
          (e.clientY - r.top - r.height / 2) * 0.35 +
          "px)";
      });
      document.addEventListener("pointerout", function (e) {
        var p = e.target.closest && e.target.closest(".pill,.big");
        if (p) p.style.transform = "";
      });

      var introFlashEl = document.getElementById("introFlash");
      if (introFlashEl) {
        setTimeout(function () {
          introFlashEl.remove();
        }, 900);
      }

      renderGrid();
    </script>
  </body>
</html>
