---
interface Props {
    isHomepage?: boolean;
}

const { isHomepage = false } = Astro.props;
---

<footer>
    <!-- BRAND LOGO MARK (Text removed as requested) -->
    <a href="/" class="footer-logo-link" aria-label="XYRO Logo" style="display:inline-block;text-decoration:none;">
        <span class="lg" role="img" aria-label="XYRO logo" style="width:min(60vw,240px);margin:0 auto 24px;--c:var(--ink)"></span>
    </a>
    
    <div style="margin: 16px 0;">
        <button id="footerCopyEmail" class="pill" style="font-size: 16px;">
            officialxyroart@gmail.com
        </button>
    </div>

    <div class="footer-socials">
        <a href="https://www.instagram.com/xyro_.art/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <span>·</span>
        <a href="https://x.com/xyro_art" target="_blank" rel="noopener noreferrer">X</a>
        <span>·</span>
        <a href="https://www.artstation.com/xyro_art" target="_blank" rel="noopener noreferrer">ArtStation</a>
        <span>·</span>
        <a href="https://discord.gg/RJ5JPCYS" target="_blank" rel="noopener noreferrer">Discord</a>
        <span>·</span>
        <a href="https://www.patreon.com/c/Xyro_art" target="_blank" rel="noopener noreferrer">Patreon</a>
        <span>·</span>
        <a href="https://www.reddit.com/user/Professional-Lake843/" target="_blank" rel="noopener noreferrer">Reddit</a>
        <span>·</span>
        <a href="https://www.deviantart.com/aman2189" target="_blank" rel="noopener noreferrer">DeviantArt</a>
        <span>·</span>
        <a href="https://pin.it/1EkhjFukQ" target="_blank" rel="noopener noreferrer">Pinterest</a>
    </div>

    <!-- PRESERVED LEGAL CENTER & POLICIES (DUPLICATE PILLS REMOVED) -->
    <div class="footer-legals-box">
        <div class="footer-legal-links">
            <a href="/legal#privacy">Privacy Policy</a>
            <span class="dot">•</span>
            <a href="/legal#terms">Terms of Service</a>
            <span class="dot">•</span>
            <a href="/legal#commissions">Commission Guide</a>
            <span class="dot">•</span>
            <a href="/legal#copyright">Copyright Notice</a>
        </div>
        <div class="footer-bottom-bar" style="justify-content:center;">
            <span>© 2026 Xyro. All Rights Reserved.</span>
        </div>
    </div>
</footer>

<style>
    .footer-socials {
        margin: 18px 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 12px 18px;
        font-size: 16px;
    }
    .footer-socials a {
        text-decoration: none;
        transition: color 0.15s, transform 0.15s;
    }
    .footer-socials a:hover,
    #footerDiscordBtn:hover {
        color: var(--pk);
        transform: translateY(-2px);
    }
    .footer-legals-box {
        margin: 36px auto 10px;
        max-width: 860px;
        border: 4px solid var(--ink);
        background: var(--bg);
        box-shadow: 6px 6px 0 var(--ink);
        padding: 20px 24px;
        border-radius: 4px;
        text-align: center;
    }
    .footer-legal-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 12px 20px;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 14px;
    }
    .footer-legal-links a {
        text-decoration: none;
        transition: color 0.15s, transform 0.15s;
    }
    .footer-legal-links a:hover {
        color: var(--pk);
        transform: translateY(-1px);
    }
    .footer-bottom-bar {
        padding-top: 14px;
        border-top: 2px solid var(--ink);
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 12px;
        font-size: 13px;
    }
    @media (max-width: 640px) {
        .footer-bottom-bar {
            flex-direction: column;
            justify-content: center;
        }
    }
</style>

<script>
    function setupFooterEvents() {
        const copyBtn = document.getElementById("footerCopyEmail");
        copyBtn?.addEventListener("click", () => {
            navigator.clipboard.writeText("officialxyroart@gmail.com");
            const original = copyBtn.innerText;
            copyBtn.innerText = "COPIED! ✓";
            setTimeout(() => {
                if (copyBtn) copyBtn.innerText = original;
            }, 2000);
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupFooterEvents);
    } else {
        setupFooterEvents();
    }
    document.addEventListener("astro:page-load", setupFooterEvents);
</script>
